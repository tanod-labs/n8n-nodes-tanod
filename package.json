{
  "name": "n8n-nodes-tanod",
  "version": "0.1.3",
  "description": "n8n community node for Tanod document, web, audio, text and email tools. Prepaid credit keys, free daily allowances and optional x402 wallet payments.",
  "license": "MIT",
  "homepage": "https://tanod.dev/connect/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanod-labs/n8n-nodes-tanod.git"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "tanod",
    "pdf",
    "ocr",
    "markdown",
    "x402",
    "screenshot",
    "transcription"
  ],
  "author": {
    "name": "Tanod",
    "email": "ops@tanod.dev"
  },
  "main": "index.js",
  "files": [
    "dist",
    "index.js"
  ],
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "rm -rf dist && tsc && node scripts/bundle-wallet.js && node scripts/copy-assets.js",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/TanodX402Api.credentials.js",
      "dist/credentials/TanodCreditsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Tanod/Tanod.node.js"
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "@x402/fetch": "2.28.0",
    "viem": "2.57.5",
    "esbuild": "0.25.11",
    "@types/node": "^22.0.0",
    "n8n-workflow": "2.16.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
